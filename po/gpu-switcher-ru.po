msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"
"MIME-Version: 1.0\n"

msgid "In use now"
msgstr "Используется сейчас"

msgid "Preferred (configured)"
msgstr "Назначен (конфигурация)"

msgid "System default (auto)"
msgstr "Системный по умолчанию (авто)"

msgid "Configured GPU (not currently detected)"
msgstr "Назначенный GPU (не обнаружен в данный момент)"

msgid "No GPUs detected."
msgstr "GPU не обнаружены."

msgid "Not running in a GNOME Wayland session - this build only supports GNOME."
msgstr "Не запущено в сессии GNOME Wayland - эта сборка поддерживает только GNOME."

msgid "Running primary: unknown (verify in the journal after restart)."
msgstr "Основной GPU сейчас: неизвестно (проверьте в журнале после перезапуска)."

msgid "Running primary: could not read the session journal (%s)."
msgstr "Основной GPU сейчас: не удалось прочитать журнал сеанса (%s)."

msgid "Running on %s (automatic selection)."
msgstr "Работает на %s (автоматический выбор)."

msgid "GNOME is using the configured GPU."
msgstr "GNOME использует назначенный GPU."

msgid "Configured for next login. Log out and back in to apply it."
msgstr "Назначено на следующий вход. Выйдите из сеанса и войдите снова, чтобы применить."

msgid "Automatic selection applies at next login. Log out and back in."
msgstr "Автоматический выбор вступит в силу при следующем входе. Выйдите из сеанса и войдите снова."

msgid "The change applies after a reboot."
msgstr "Изменение вступит в силу после перезагрузки."

msgid "GNOME is running on %(running)s, not the configured %(configured)s. Check for conflicting rules or whether that GPU was available at login."
msgstr "GNOME работает на %(running)s, а не на назначенном %(configured)s. Проверьте конфликтующие правила и был ли этот GPU доступен при входе."

msgid "automatic selection"
msgstr "автоматический выбор"

# App UI: actions and dialogs

msgid "Apply"
msgstr "Применить"

msgid "Reset to auto"
msgstr "Сбросить к авто"

msgid "Reboot now"
msgstr "Перезагрузить сейчас"

msgid "Reboot"
msgstr "Перезагрузить"

msgid "Cancel"
msgstr "Отмена"

msgid "Rebooting."
msgstr "Идёт перезагрузка."

msgid "Reboot failed."
msgstr "Не удалось перезагрузить."

msgid "Log out"
msgstr "Выйти"

msgid "Log out now? The session will end, and the configured GPU takes effect on the next login."
msgstr "Выйти из сессии сейчас? Сессия будет завершена, и настроенный GPU вступит в силу после повторного входа."

msgid "Logging out."
msgstr "Идёт выход из сессии."

msgid "Log out failed."
msgstr "Не удалось выйти из сессии."

msgid "Detecting…"
msgstr "Определение…"

msgid "Could not log out: %s."
msgstr "Не удалось завершить сессию: %s."

msgid "Could not reach the GPU helper: %s."
msgstr "Не удалось связаться с GPU-хелпером: %s."

msgid "Could not reach logind: %s."
msgstr "Не удалось связаться с logind: %s."

msgid "The GPU helper is not available. Install the gpu-switcher package."
msgstr "GPU-хелпер недоступен. Установите пакет gpu-switcher."
msgid "The GPU helper did not answer in time."
msgstr "GPU-хелпер не ответил за отведённое время."
msgid "The GPU helper stopped answering."
msgstr "GPU-хелпер перестал отвечать."
msgid "The outcome is unknown; the current state was rechecked."
msgstr "Исход неизвестен; текущее состояние проверено заново."

msgid "How to verify the switch after restart"
msgstr "Как проверить смену после перезапуска"

msgid "Run in a terminal after reboot or login:"
msgstr "В терминале после перезагрузки или входа:"

msgid "and look for a line like:"
msgstr "и ищите строку вида:"

msgid "Reboot the computer now?"
msgstr "Перезагрузить компьютер сейчас?"

msgid "Are you sure? The system will reboot immediately and the selected GPU will become primary on boot."
msgstr "Вы уверены? Система немедленно перезагрузится, и выбранный GPU станет основным при загрузке."

msgid "Apply sets %s (PCI %s) as the primary display adapter.\n\nThe managed udev rule is written; if a rule is present, a backup is saved. The change takes effect after a reboot, or after logging out and back in."
msgstr "Будет назначен %s (PCI %s) основным дисплейным адаптером.\n\nЗапишется управляемое udev-правило; если правило присутствует, будет сохранена резервная копия. Изменение вступит в силу после перезагрузки, либо после выхода из сессии и повторного входа."

msgid "Apply removes the managed udev rule, returning to automatic GPU selection.\n\nIf a rule is present, a backup is saved. The change takes effect after a reboot, or after logging out and back in."
msgstr "Удалится управляемое udev-правило и выбор GPU снова станет автоматическим.\n\nЕсли правило присутствует, будет сохранена резервная копия. Изменение вступит в силу после перезагрузки, либо после выхода из сессии и повторного входа."

msgid "The configured GPU (PCI %s) is not currently detected. The rule remains on disk; it takes effect when the GPU is available again. Use 'Reset to auto' to remove it."
msgstr "Назначенный GPU (PCI %s) не обнаружен в данный момент. Правило остаётся на диске; оно вступит в силу, когда GPU снова будет доступен. Используйте «Сбросить к авто», чтобы удалить его."

msgid "The configured GPU (PCI %s) is not currently detected, so there is nothing to apply. The rule stays on disk; use 'Reset to auto' to remove it."
msgstr "Назначенный GPU (PCI %s) не обнаружен в данный момент, поэтому применять нечего. Правило остаётся на диске; используйте «Сбросить к авто», чтобы удалить его."

# Helper messages (the helper loads the same catalogs; one message is shared
# with the app's startup conflict warning)

msgid "Managed rule present."
msgstr "Управляемое правило присутствует."

msgid "No managed rule (auto selection)."
msgstr "Управляемого правила нет (автовыбор)."

msgid "Authentication is required to change the primary display adapter."
msgstr "Для смены основного дисплейного адаптера требуется авторизация."

msgid "Authorization was denied. Nothing changed."
msgstr "Авторизация отклонена. Ничего не изменено."

msgid "Authorization was cancelled. Nothing changed."
msgstr "Авторизация отменена. Ничего не изменено."

msgid "The authorization check timed out. Nothing changed."
msgstr "Время ожидания проверки авторизации истекло. Ничего не изменено."

msgid "Could not check authorization (%s). Nothing changed."
msgstr "Не удалось проверить авторизацию (%s). Ничего не изменено."

msgid "Another udev rule sets the preferred GPU: %s. Resolve it manually first."
msgstr "Другое udev-правило задаёт предпочтительный GPU: %s. Сначала устраните его вручную."

msgid "Could not read the udev rule %s. It might set the preferred GPU; make it readable or remove it."
msgstr "Не удалось прочитать правило udev %s. Возможно, оно задаёт предпочтительный GPU — сделайте его читаемым или удалите."

msgid "Target PCI %s is not a valid display controller."
msgstr "Целевой PCI %s — не корректный дисплейный контроллер."

msgid "The managed rule is a symlink; refusing to modify it."
msgstr "Управляемое правило — символьная ссылка; его изменение отклонено."

# The post-refresh replies are composed by the helper from the leading
# sentence, the optional backup sentence and the shared outcome sentence
# (single-space join); the fragments below are the catalog entries.
msgid "The rule is already set for %s."
msgstr "Правило уже задано для %s."

msgid "Rule written for %s."
msgstr "Правило записано для %s."
msgid "Rule written for %s without udevadm verification."
msgstr "Правило записано для %s без проверки udevadm."

msgid "No managed rule (auto selection already in effect)."
msgstr "Управляемого правила нет (автовыбор уже действует)."

msgid "Managed rule removed."
msgstr "Управляемое правило удалено."

msgid "Udev rules reloaded."
msgstr "udev-правила перезагружены."

msgid "The udev refresh could not be verified (udevadm unavailable); a reboot is required."
msgstr "Обновление udev не удалось проверить (udevadm недоступен); требуется перезагрузка."

msgid "The udev refresh failed; a reboot is required."
msgstr "Обновление udev не удалось; требуется перезагрузка."

msgid "udevadm verify rejected the rule; nothing changed."
msgstr "udevadm verify отклонил правило; ничего не изменено."

msgid "Backup of the existing rule failed; nothing changed."
msgstr "Не удалось создать резервную копию текущего правила; ничего не изменено."

msgid "Failed to write the managed rule; nothing changed."
msgstr "Не удалось записать управляемое правило; ничего не изменено."

msgid "The managed rule is a symlink; refusing to remove it."
msgstr "Управляемое правило — символьная ссылка; его удаление отклонено."

msgid "Backup of the existing rule failed; nothing removed."
msgstr "Не удалось создать резервную копию текущего правила; ничего не удалено."

msgid "Failed to remove the managed rule; nothing changed."
msgstr "Не удалось удалить управляемое правило; ничего не изменено."

msgid "Could not determine the logind session to log out."
msgstr "Не удалось определить сессию logind для выхода."

msgid "Detection failed: %s."
msgstr "Не удалось выполнить обнаружение: %s."

msgid "The selected GPU is no longer detected; re-checking…"
msgstr "Выбранный GPU больше не обнаружен; выполняется повторная проверка…"

msgid "The managed udev rule could not be interpreted, so the configured GPU is unknown (this is not automatic selection). Use 'Reset to auto' or Apply to rewrite it."
msgstr "Управляемое udev-правило не удалось разобрать, поэтому назначенный GPU неизвестен (это не автоматический выбор). Используйте «Сбросить к авто» или «Применить», чтобы переписать его."
