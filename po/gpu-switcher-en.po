msgstr "Target PCI %s is not a valid display controller."

msgid "The managed rule is a symlink; refusing to modify it."
msgstr "The managed rule is a symlink; refusing to modify it."

# The post-refresh replies are composed by the helper from the leading
# sentence, the optional backup sentence and the shared outcome sentence
# (single-space join); the fragments below are the catalog entries.
