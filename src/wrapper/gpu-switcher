#!/usr/bin/env python3
"""Entry point installed as /usr/bin/gpu-switcher.

With a command the answer is printed in the terminal (see gpu_switcher.cli); with
none, the window opens. The front-end imports GTK only for the window, so
`gpu-switcher list` works over ssh.
"""
import sys

from gpu_switcher import cli

sys.exit(cli.run(sys.argv))
