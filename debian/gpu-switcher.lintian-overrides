# The helper unit is D-Bus-activated and not enabled, so its lifecycle is
# written in debian/postinst instead of being generated by dh_installsystemd
# (disabled in debian/rules, because tools/build-deb.sh builds without debhelper
# and both build paths must ship the same scripts). The recommended
# deb-systemd-invoke is a debhelper tool an installed system is not required to
# provide, and the /run/systemd/system guard in debian/postinst is the check it
# performs internally. Every call here is a reload or a try-restart, so a helper
# that already exited on idle is never started or disturbed.
gpu-switcher: maintainer-script-calls-systemctl
