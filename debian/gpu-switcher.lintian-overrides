# The helper unit is D-Bus-activated and not enabled, so its lifecycle is written
# in debian/postinst rather than generated by dh_installsystemd (disabled in
# debian/rules: tools/build-deb.sh builds without debhelper, and both build paths
# must ship the same scripts). deb-systemd-invoke is a debhelper tool an installed
# system need not provide; debian/postinst checks /run/systemd/system itself.
# Every call is a reload or a try-restart, so an already exited helper is never
# started.
gpu-switcher: maintainer-script-calls-systemctl
