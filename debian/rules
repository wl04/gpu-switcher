#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Pure Python: nothing to compile, except the rendered man page header
	# (dh_installman installs build/man/gpu-switcher.1). File installation
	# happens in dh_auto_install (the Makefile install target). Without this
	# override, dh runs bare `make`, whose default goal is `test`.
	$(MAKE) man

override_dh_auto_test:
	# The test suite runs in CI (the check job) under a virtual display; the
	# dh build does not need to run it (and the GUI tests need a display).

override_dh_auto_install:
	# The single package file list lives in the Makefile `install` target;
	# calling it here keeps this dh path in sync with tools/build-deb.sh.
	# (It also compiles the gettext catalogs.)
	$(MAKE) install DESTDIR=debian/gpu-switcher

override_dh_installsystemd:
	# Deliberately empty: the helper unit is D-Bus-activated and not enabled, and
	# its lifecycle is written in debian/postinst and debian/postrm so both build
	# paths ship the same scripts. A generated postinst would also start the unit
	# right after installation, which an on-demand service does not need.

# Debian docs (changelog, man page) are installed and compressed by
# dh_installdocs/dh_installman/dh_compress; copyright is installed by the
# install target and the maintainer scripts (debian/postinst, debian/postrm)
# by dh_installdeb.
