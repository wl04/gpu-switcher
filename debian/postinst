#!/bin/sh
set -e

# The helper unit is not enabled: dbus-daemon starts it on demand
# (SystemdService= in the D-Bus service file) and the process exits on its own
# once it has been idle. Its lifecycle lives in these scripts rather than in
# debhelper-generated ones so both build paths ship the same ones; see
# debian/gpu-switcher.lintian-overrides.

case "$1" in
  configure)
    if [ -d /run/systemd/system ]; then
      # systemd keeps the unit file it loaded before the package changed it:
      # without this reload an upgrade would keep running the old settings.
      systemctl --system daemon-reload >/dev/null || true
      if [ -n "$2" ]; then
        # Upgrade: drop a helper that is still running, or a call within the
        # next minute could be answered by the code that was just replaced
        # (try-restart is a no-op when the unit is inactive).
        systemctl --system try-restart gpu-switcher-helper.service >/dev/null || true
      fi
    fi
    ;;
esac

exit 0
